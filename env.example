# Скопируйте в .env (cp env.example .env) и заполните ДВА значения ниже.
# Всё остальное имеет рабочие значения по умолчанию в compose.yaml.

# Токен Telegram-бота: создайте бота у @BotFather командой /newbot и скопируйте токен.
ALFA_TELEGRAM_BOT_TOKEN=

# API-ключ Yandex AI Studio (сервисному аккаунту нужна роль ai.languageModels.user).
# Как получить: https://yandex.cloud/ru/docs/ai-studio/quickstart
ALFA_YANDEX_API_KEY=

# --- Необязательно ---
# Идентификатор папки Yandex Cloud, если ключ выдан не на папку по умолчанию.
# ALFA_YANDEX_FOLDER_ID=
# Telegram ID администраторов (через запятую): им доступны /stats (метрики и A/B) и /export.
# Свой ID можно узнать у бота @userinfobot.
# ALFA_ADMIN_IDS=
# Публичный https-адрес мини-приложения (кнопка «Приложение» в боте); без него бот работает как раньше.
# ALFA_WEBAPP_URL=
